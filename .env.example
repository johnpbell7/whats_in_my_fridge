# Copy this file to ".env" and fill in your key. The .env file is gitignored
# and is read ONLY by the server (server/index.js) — it is never bundled into
# the frontend, so your key stays private.

# Required for the chat and photo-recognition features.
# Get one at https://console.anthropic.com/ and add a little credit.
ANTHROPIC_API_KEY=

# Optional — override the models. Defaults are chosen for cost vs. accuracy.
# Vision needs to read a cluttered fridge photo, so it defaults to Sonnet.
# Chat is tiny, so it defaults to the cheaper, faster Haiku.
VISION_MODEL=claude-sonnet-4-6
CHAT_MODEL=claude-haiku-4-5-20251001

# Optional — the port the API listens on (the web app proxies /api to it).
API_PORT=8787

# --- Accounts (optional) ---------------------------------------------------
# Leave these blank to run in single-user "open" mode (no login). Fill them in
# to switch on accounts + per-user usage limits. See SETUP_ACCOUNTS.md.
#
# Server-side (private — never sent to the browser):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# Browser-side (public, safe to ship — must be VITE_ prefixed):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Payments (optional) ---------------------------------------------------
# Stripe subscription (Plus). Leave blank to keep card payments off — the app
# degrades gracefully until these are set. All server-side (never sent to the
# browser). Use LIVE values (sk_live_… / live price / live whsec_…) for real
# payments; test-mode values are completely separate.
#
# Secret key — Stripe → Developers → API keys:
STRIPE_SECRET_KEY=
# Recurring price ID for Plus (£3.99/mo) — Stripe → Product catalogue:
STRIPE_PRICE_ID=
# Webhook signing secret — Stripe → Developers → Webhooks. Point the endpoint
# at https://<your-app-domain>/api/stripe-webhook and subscribe to
# checkout.session.completed, customer.subscription.updated & .deleted:
STRIPE_WEBHOOK_SECRET=
#
# Public app URL used for checkout success/cancel + billing-portal return.
# Defaults to https://app.whatsinmyfridge.co.uk if unset.
APP_URL=

# --- Error monitoring (optional) -------------------------------------------
# Sentry DSN for the frontend. Leave blank to keep monitoring off (the SDK is
# lazy-loaded, so it adds nothing until this is set). Create a project at
# sentry.io → it gives you a DSN like https://abc@o123.ingest.sentry.io/456
VITE_SENTRY_DSN=
