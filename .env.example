# Copy this file to ".env" and fill in your key. The .env file is gitignored
# and is read ONLY by the server (server/index.js) — it is never bundled into
# the frontend, so your key stays private.

# Required for the chat and photo-recognition features.
# Get one at https://console.anthropic.com/ and add a little credit.
ANTHROPIC_API_KEY=

# Optional — override the models. Defaults are chosen for cost vs. accuracy.
# Vision needs to read a cluttered fridge photo, so it defaults to Sonnet.
# Chat is tiny, so it defaults to the cheaper, faster Haiku.
VISION_MODEL=claude-sonnet-4-6
CHAT_MODEL=claude-haiku-4-5-20251001

# Optional — the port the API listens on (the web app proxies /api to it).
API_PORT=8787
